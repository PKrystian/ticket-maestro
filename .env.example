CLOUD_TASKS_QUEUE=
CLOUD_TASKS_LOCATION=europe-west1
CLOUD_TASKS_SERVICE_ACCOUNT=
SERVICE_BASE_URL=
EMAIL_WORKER_SERVICE_ACCOUNT=
# Production: provide GOOGLE_APPLICATION_CREDENTIALS through the runtime secret mechanism,
# or use the Cloud Run service identity. Never commit service account JSON.
# Set ALLOW_REMOTE_LOAD_TESTS=true only when intentionally testing your own remote deployment.
