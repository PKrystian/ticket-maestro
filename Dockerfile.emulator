FROM node:24-trixie-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-21-jre-headless ca-certificates && rm -rf /var/lib/apt/lists/* \
  && npm install --global firebase-tools@15.34.1
WORKDIR /workspace
COPY firebase.json firestore.rules firestore.indexes.json ./
EXPOSE 4000 8081 9099
CMD ["firebase", "emulators:start", "--project", "ticket-maestro-local", "--only", "auth,firestore", "--import=/data", "--export-on-exit=/data"]
