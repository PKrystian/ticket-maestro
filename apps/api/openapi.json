{
  "openapi": "3.1.0",
  "info": { "title": "TicketMaestro REST API", "version": "1.0.0", "description": "Event catalog, ticket reservations, simulated purchase verification and administration." },
  "servers": [{ "url": "/api", "description": "Same-origin Cloud Run or local API" }],
  "tags": [{ "name": "Auth" }, { "name": "Events" }, { "name": "Reservations" }, { "name": "Organizer" }, { "name": "Admin" }, { "name": "Email" }],
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "Firebase ID token" } },
    "schemas": {
      "Error": { "type": "object", "required": ["error", "message"], "properties": { "error": { "type": "string" }, "message": { "type": "string" } } },
      "EventInput": { "type": "object", "required": ["title", "description", "category", "date", "location", "imageUrl", "capacity"], "properties": { "title": { "type": "string", "minLength": 3, "maxLength": 120 }, "description": { "type": "string", "minLength": 10, "maxLength": 5000 }, "category": { "type": "string" }, "date": { "type": "string", "format": "date-time" }, "location": { "type": "string" }, "imageUrl": { "type": "string", "format": "uri", "description": "HTTP(S) URL or empty string" }, "capacity": { "type": "integer", "minimum": 10, "maximum": 20000 }, "status": { "type": "string", "enum": ["DRAFT", "PUBLISHED", "CANCELLED", "COMPLETED"] } } },
      "ReservationInput": { "type": "object", "required": ["quantity"], "properties": { "quantity": { "type": "integer", "minimum": 1, "maximum": 5 } } },
      "Page": { "type": "object", "properties": { "items": { "type": "array", "items": { "type": "object" } }, "page": { "type": "integer" }, "pageSize": { "type": "integer" }, "total": { "type": "integer" }, "hasMore": { "type": "boolean" }, "nextCursor": { "type": "string" } } }
    },
    "parameters": { "Id": { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } } },
    "responses": {
      "BadRequest": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Unauthorized": { "description": "Missing or invalid Firebase ID token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Forbidden": { "description": "Insufficient role or record ownership", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Conflict": { "description": "Inventory, capacity, idempotency, or state conflict", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    }
  },
  "paths": {
    "/auth/profile": { "post": { "tags": ["Auth"], "summary": "Create the authenticated user's default USER profile if missing", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Profile is ready" }, "401": { "$ref": "#/components/responses/Unauthorized" } } } },
    "/me": { "get": { "tags": ["Auth"], "summary": "Return the authenticated user and server-resolved role", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Authenticated profile" }, "401": { "$ref": "#/components/responses/Unauthorized" } } } },
    "/events": { "get": { "tags": ["Events"], "summary": "Search and cursor-page published events", "parameters": [{ "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Normalized title prefix" }, { "name": "category", "in": "query", "schema": { "type": "string" } }, { "name": "from", "in": "query", "schema": { "type": "string", "format": "date" } }, { "name": "to", "in": "query", "schema": { "type": "string", "format": "date" } }, { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["date-asc", "date-desc", "title"] } }, { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } }, { "name": "pageSize", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 48 } }, { "name": "cursor", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "Page of event records", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Page" } } } }, "400": { "$ref": "#/components/responses/BadRequest" } } }, "post": { "tags": ["Organizer"], "summary": "Create an event", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EventInput" } } } }, "responses": { "201": { "description": "Created event" }, "400": { "$ref": "#/components/responses/BadRequest" }, "403": { "$ref": "#/components/responses/Forbidden" } } } },
    "/events/{id}": { "get": { "tags": ["Events"], "summary": "Read published event detail", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "description": "Event record" }, "404": { "description": "Not found" } } }, "put": { "tags": ["Organizer"], "summary": "Update an event owned by the manager or any event as admin", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/Id" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EventInput" } } } }, "responses": { "200": { "description": "Updated event" }, "409": { "$ref": "#/components/responses/Conflict" }, "403": { "$ref": "#/components/responses/Forbidden" } } }, "delete": { "tags": ["Organizer"], "summary": "Delete an event with no active reservations", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "204": { "description": "Deleted" }, "409": { "$ref": "#/components/responses/Conflict" } } } },
    "/events/{id}/availability": { "get": { "tags": ["Events"], "summary": "Read authoritative current inventory", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "description": "Current availability and capacity" }, "404": { "description": "Not found" } } } },
    "/events/{id}/reservations": { "post": { "tags": ["Reservations"], "summary": "Atomically reserve 1–5 tickets", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/Id" }, { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "maxLength": 160 } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReservationInput" } } } }, "responses": { "201": { "description": "Reservation created in PENDING_PAYMENT" }, "200": { "description": "Idempotent replay of original reservation" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "409": { "$ref": "#/components/responses/Conflict" } } } },
    "/reservations": { "get": { "tags": ["Reservations"], "summary": "List up to 100 recent reservations owned by the user", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Reservation list" }, "401": { "$ref": "#/components/responses/Unauthorized" } } } },
    "/reservations/{id}/checkout": { "post": { "tags": ["Reservations"], "summary": "Verify the simulated purchase and create ticket IDs", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/Id" }], "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "simulateFailure": { "type": "boolean", "description": "Local/test checkout failure only" } } } } } }, "responses": { "200": { "description": "Purchase confirmed; email confirmation queued" }, "402": { "description": "Simulated checkout failed and inventory was restored" }, "403": { "$ref": "#/components/responses/Forbidden" }, "409": { "$ref": "#/components/responses/Conflict" } } } },
    "/reservations/{id}/cancel": { "post": { "tags": ["Reservations"], "summary": "Cancel an eligible reservation owned by the user", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "description": "Cancelled reservation" }, "403": { "$ref": "#/components/responses/Forbidden" }, "409": { "$ref": "#/components/responses/Conflict" } } } },
    "/reservations/{id}/tickets": { "get": { "tags": ["Reservations"], "summary": "Read ticket codes for an owned confirmed reservation", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "description": "Ticket records" }, "403": { "$ref": "#/components/responses/Forbidden" }, "409": { "$ref": "#/components/responses/Conflict" } } } },
    "/reservations/{id}/email/retry": { "post": { "tags": ["Email"], "summary": "Queue or explicitly process a retryable confirmation email", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "description": "Current asynchronous delivery status" }, "403": { "$ref": "#/components/responses/Forbidden" }, "409": { "$ref": "#/components/responses/Conflict" } } } },
    "/manager/events": { "get": { "tags": ["Organizer"], "summary": "Cursor-page events owned by the manager (admin sees all)", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Manager event page" }, "403": { "$ref": "#/components/responses/Forbidden" } } } },
    "/admin/stats": { "get": { "tags": ["Admin"], "summary": "Read platform counts, inventory occupancy, popular events, and event statistics", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Admin dashboard metrics" }, "403": { "$ref": "#/components/responses/Forbidden" } } } }
  }
}
